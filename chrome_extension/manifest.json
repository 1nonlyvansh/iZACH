{
  "manifest_version": 3,
  "name": "iZACH Assistant",
  "version": "1.0",
  "description": "Lets iZACH fill forms in your active Chrome tab.",
  "permissions": ["activeTab", "tabs", "alarms"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "iZACH"
  }
}
