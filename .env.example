# iZACH Environment Configuration
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env — it is git-ignored.

# --- Owner ---
OWNER_NAME=YourName

# --- Groq (LLM / Whisper / WhatsApp) ---
GROQ_API_KEY=
GROQ_VISION_KEY=
GROQ_WA_KEY=

# --- Google Gemini (rotated for rate limits) ---
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_VISION_KEY_1=
GEMINI_VISION_KEY_2=
GEMINI_VISION_KEY_3=

# --- Spotify Web API ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- OpenRouter (vision fallback) ---
# Register at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Edamam Food Database ---
# Register at: https://developer.edamam.com/food-database-api
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# --- N8N Automation ---
N8N_URL=http://localhost:5678
N8N_SHARED_TOKEN=

# --- iZACH Mobile/MMA token ---
MMA_TOKEN=

# --- Samsung SmartThings ---
# Get token at: https://account.smartthings.com/tokens
SMARTTHINGS_TOKEN=

# --- DeepSeek (Skills / programming) ---
# Free tier: https://platform.deepseek.com
# Used for #html-builder, #python-dev, #java-dev, #c-programming, etc.
DEEPSEEK_API_KEY=

# --- Dual-instance / cross-machine daemon ---
# Shared secret between this machine and its peer (Mac<->Windows). Generate
# once (e.g. `python3 -c "import secrets; print(secrets.token_hex(24))"`)
# and set the SAME value on both machines — used for peer-status checks,
# handoff, and the boot daemon's remote-start trigger.
IZACH_PEER_TOKEN=
# Port the always-on boot daemon (boot_daemon.py) listens on. Separate from
# iZACH's own port 5050 since the daemon must run even when iZACH isn't.
IZACH_DAEMON_PORT=5052
