# iZACH Environment Configuration
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env — it is git-ignored.

# Owner name (used in responses and prompts)
OWNER_NAME=Vansh

# Groq API (used for fast LLM responses)
GROQ_API_KEY=

# Google Gemini API keys (rotated for rate limit handling)
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=

# Spotify Web API
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
