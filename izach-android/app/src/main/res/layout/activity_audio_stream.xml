<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/bg_panel"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnAudioBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PC AUDIO STREAM"
            android:textColor="@color/cyan"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:paddingStart="8dp" />
    </LinearLayout>

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Audio waveform icon placeholder -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊"
            android:textSize="72sp"
            android:layout_marginBottom="24dp" />

        <!-- Status text -->
        <TextView
            android:id="@+id/tvAudioStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to start streaming"
            android:textColor="@color/cyan"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <!-- Info text -->
        <TextView
            android:id="@+id/tvAudioInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_sec"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- Play/Stop toggle button -->
        <ImageButton
            android:id="@+id/btnAudioToggle"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_play"
            android:contentDescription="Start / Stop stream"
            android:padding="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streams PC speakers over Wi-Fi\nRequires ffmpeg on PC"
            android:textColor="@color/text_sec"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="32dp" />
    </LinearLayout>

</LinearLayout>
