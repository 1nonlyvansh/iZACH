<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:padding="12dp">

    <!-- Row 1: type badge + from + timestamp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvAlertType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WA"
            android:textColor="#FF25D366"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="#2025D366"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvAlertFrom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="From · Number"
            android:textColor="@color/text_pri"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvAlertTs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/text_sec"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Row 2: message text preview -->
    <TextView
        android:id="@+id/tvAlertText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_sec"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_marginBottom="8dp" />

    <!-- Row 3: action buttons OR status label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/tvAlertAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAlertBusy"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="BUSY"
            android:textColor="#FFff8c00"
            android:backgroundTint="#20ff8c00"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="8dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnAlertHandle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="HANDLE"
            android:textColor="@color/bg_deep"
            android:backgroundTint="@color/cyan"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:paddingHorizontal="14dp"
            style="@style/Widget.MaterialComponents.Button" />
    </LinearLayout>

</LinearLayout>
