<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_panel"
    android:paddingBottom="24dp">

    <View
        android:id="@+id/qcHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:background="#FF3a6070"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/qcHeader"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/qcHandle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QUICK COMMANDS"
            android:textColor="@color/cyan"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />

        <ImageButton
            android:id="@+id/btnCloseQuick"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />
    </LinearLayout>

    <View
        android:id="@+id/qcDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#FF005060"
        app:layout_constraintTop_toBottomOf="@id/qcHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Row 1: System + Volume -->
    <LinearLayout
        android:id="@+id/qcRow1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/qcDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/btnLockPc"
            android:layout_width="0dp" android:layout_height="72dp"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@color/bg_card"
            android:layout_marginEnd="6dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_settings" android:contentDescription="Lock PC" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Lock PC" android:textColor="@color/text_pri"
                android:textSize="10sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnQScreenshot"
            android:layout_width="0dp" android:layout_height="72dp"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@color/bg_card"
            android:layout_marginEnd="6dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_screenshot" android:contentDescription="Screenshot" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Screenshot" android:textColor="@color/text_pri"
                android:textSize="10sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnVolUp"
            android:layout_width="0dp" android:layout_height="72dp"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@color/bg_card"
            android:layout_marginEnd="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔊" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Vol Up" android:textColor="@color/text_pri"
                android:textSize="10sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnVolDown"
            android:layout_width="0dp" android:layout_height="72dp"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@color/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔉" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Vol Down" android:textColor="@color/text_pri"
                android:textSize="10sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: Media -->
    <LinearLayout
        android:id="@+id/qcRow2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/qcRow1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/btnMute"
            android:layout_width="0dp" android:layout_height="72dp"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@color/bg_card"
            android:layout_marginEnd="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔇" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mute" android:textColor="@color/text_pri"
                android:textSize="10sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnPlayPause"
            android:layout_width="0dp" android:layout_height="72dp"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@color/bg_card"
            android:layout_marginEnd="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏯" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Play/Pause" android:textColor="@color/text_pri"
                android:textSize="10sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnNextTrack"
            android:layout_width="0dp" android:layout_height="72dp"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@color/bg_card"
            android:layout_marginEnd="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏭" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Next" android:textColor="@color/text_pri"
                android:textSize="10sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnPrevTrack"
            android:layout_width="0dp" android:layout_height="72dp"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@color/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏮" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Prev" android:textColor="@color/text_pri"
                android:textSize="10sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
