<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SETTINGS"
                android:textColor="@color/cyan"
                android:textSize="16sp"
                android:letterSpacing="0.3"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center" />

            <View android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>

        <!-- QR scan section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONNECTION"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:layout_marginBottom="12dp" />

        <!-- Paired state — replaces the scan prompt once pairingSecret() is set
             and the PC actually confirms it via /status. -->
        <LinearLayout
            android:id="@+id/pairedInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_green" />
                <TextView
                    android:id="@+id/tvPairedPcName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Connected to PC"
                    android:textColor="@color/text_pri"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPairedBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_sec"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnRepair"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="RE-PAIR / SCAN NEW QR"
                android:textColor="@color/cyan"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:paddingHorizontal="0dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Not-paired state — scan prompt + manual entry fields -->
        <LinearLayout
            android:id="@+id/unpairedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_amber" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Not paired — scan the QR code below"
                    android:textColor="@color/amber"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <Button
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SCAN QR CODE"
                android:textColor="@color/bg_deep"
                android:backgroundTint="@color/cyan"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Point camera at the QR code shown in the iZACH desktop panel"
                android:textColor="@color/text_sec"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="— or enter manually —"
                android:textColor="@color/text_sec"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_backend_url"
                android:textColor="@color/text_sec"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etBackendUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_backend_url"
                android:textColor="@color/text_pri"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="12dp"
                android:inputType="textUri"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_ws_host"
                android:textColor="@color/text_sec"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etWsHost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_ws_host"
                android:textColor="@color/text_pri"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pairing Secret"
                android:textColor="@color/text_sec"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPairingSecret"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="Copied from the desktop app under the QR code"
                android:textColor="@color/text_pri"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="32dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="TEST CONNECTION"
            android:textColor="@color/cyan"
            android:backgroundTint="@color/bg_card"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_sec"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Notification Categories -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NOTIFICATIONS"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="System alerts"
                android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swNotifSystem"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Downloads"
                android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swNotifDownloads"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Transfers"
                android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swNotifTransfers"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Automation"
                android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swNotifAutomation"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Alerts"
                android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swNotifAlerts"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- Security Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SECURITY"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Biometric lock"
                    android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Require fingerprint/face on open"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swBiometric"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Floating mic button"
                    android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Show always-on mic overlay"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swFloatMic"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Persistent status notification"
                    android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Connection, DND, Busy &amp; PC Background Mode at a glance"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swPersistentStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- AlliedNode 2 section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALLIEDNODE 2"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Secondary PC URL"
            android:textColor="@color/text_sec"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etAlliedUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="http://192.168.1.101:5050"
            android:textColor="@color/text_pri"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:inputType="textUri"
            android:layout_marginBottom="24dp" />

        <!-- Auto-DND Schedule section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUTO-DND SCHEDULE"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:layout_marginBottom="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Enable Auto-DND"
                    android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DND turns on/off on schedule"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swAutoDnd"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DND Start (24h)"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etDndStart"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:hint="22:00" android:textColor="@color/text_pri"
                    android:textSize="13sp" android:fontFamily="monospace"
                    android:paddingHorizontal="10dp"
                    android:inputType="time" />
            </LinearLayout>

            <View android:layout_width="16dp" android:layout_height="1dp" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DND End (24h)"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etDndEnd"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:hint="08:00" android:textColor="@color/text_pri"
                    android:textSize="13sp" android:fontFamily="monospace"
                    android:paddingHorizontal="10dp"
                    android:inputType="time" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── VIP CONTACTS (DND BYPASS) ─────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIP CONTACTS (DND BYPASS)"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Messages from these numbers/names bypass DND and notify immediately."
            android:textColor="@color/text_sec"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:paddingBottom="8dp" />

        <!-- VIP list container — populated by code -->
        <LinearLayout
            android:id="@+id/vipListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="6dp" />

        <!-- Add VIP row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/etVipInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="+91XXXXXXXXXX or Name"
                android:textColor="@color/text_pri"
                android:textColorHint="@color/text_sec"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="10dp"
                android:inputType="text"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnVipAdd"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="ADD"
                android:textColor="@color/bg_deep"
                android:backgroundTint="@color/cyan"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- Proactive agent section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PROACTIVE AGENT"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Proactive agent enabled"
                    android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Morning briefing, event alerts, idle nudges"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swProactiveEnabled"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Calendar event alerts"
                    android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Announce events 60/15 min ahead"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swBriefingCalendar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="System status in briefing"
                    android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Mention battery/RAM in morning briefing"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swBriefingSystem"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pattern-to-automation suggestions"
                    android:textColor="@color/text_pri" android:textSize="13sp" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Offer to automate things you do on a schedule"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swPatternSuggestions"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="24dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Briefing time (24h)"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etBriefingTime"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:hint="08:00" android:textColor="@color/text_pri"
                    android:textSize="13sp" android:fontFamily="monospace"
                    android:paddingHorizontal="10dp"
                    android:inputType="time" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Weather city"
                    android:textColor="@color/text_sec" android:textSize="11sp" android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etWeatherCity"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:hint="New Delhi" android:textColor="@color/text_pri"
                    android:textSize="13sp" android:fontFamily="monospace"
                    android:paddingHorizontal="10dp"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SAVE"
            android:textColor="@color/bg_deep"
            android:backgroundTint="@color/cyan"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
