<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <LinearLayout
        android:id="@+id/clipTopBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/bg_panel"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CLIPBOARD SYNC"
            android:textColor="@color/cyan"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.2" />

        <View android:layout_width="40dp" android:layout_height="1dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSendToPC"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:text="SEND PHONE CLIPBOARD → PC"
        android:textColor="@color/bg_deep"
        android:backgroundTint="@color/cyan"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/clipTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No clipboard history yet"
        android:textColor="@color/text_sec"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnSendToPC"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvClipboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnSendToPC"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
