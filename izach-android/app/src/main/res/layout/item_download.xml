<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:background="@color/bg_card"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="3dp">

    <ImageView
        android:id="@+id/ivDlStatus"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_download"
        android:contentDescription="Download status"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDlFilename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_pri"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:ellipsize="middle"
            android:singleLine="true" />

        <ProgressBar
            android:id="@+id/dlProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:indeterminate="true"
            android:progressTint="#FF00e5ff"
            android:progressBackgroundTint="#FF005060"
            android:indeterminateTint="#FF00e5ff"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvDlSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_sec"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDlSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_sec"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginStart="8dp" />

</LinearLayout>
