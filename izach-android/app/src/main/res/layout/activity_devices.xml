<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <!-- Header -->
    <LinearLayout android:id="@+id/topBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:background="@color/bg_panel"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="8dp">
        <ImageButton android:id="@+id/btnBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back" android:contentDescription="Back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:text="DEVICES" android:textColor="@color/cyan" android:textSize="14sp"
            android:fontFamily="monospace" android:letterSpacing="0.2" android:textStyle="bold" />
        <View android:layout_width="48dp" android:layout_height="48dp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- THIS DEVICE -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CONNECTED TO" android:textColor="@color/cyan" android:textSize="11sp"
                android:fontFamily="monospace" android:letterSpacing="0.2"
                android:layout_marginBottom="12dp" />

            <LinearLayout android:id="@+id/cardThisDevice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@color/bg_card" android:padding="14dp"
                android:layout_marginBottom="24dp">
                <TextView android:id="@+id/tvThisDeviceIcon"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💻" android:textSize="22sp" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvThisDeviceName"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_pri" android:textSize="13sp"
                        android:fontFamily="monospace" android:textStyle="bold" />
                    <TextView android:id="@+id/tvThisDevicePlatform"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Checking…" android:textColor="@color/text_sec" android:textSize="11sp"
                        android:fontFamily="monospace" android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView android:id="@+id/tvThisDeviceRole"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PRIMARY" android:textColor="@color/green_neon" android:textSize="10sp"
                    android:fontFamily="monospace" android:textStyle="bold" />
            </LinearLayout>

            <!-- PEER -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PAIRED PEER" android:textColor="@color/cyan" android:textSize="11sp"
                android:fontFamily="monospace" android:letterSpacing="0.2"
                android:layout_marginBottom="12dp" />

            <LinearLayout android:id="@+id/cardPeer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@color/bg_card" android:padding="14dp"
                android:layout_marginBottom="16dp">
                <TextView android:id="@+id/tvPeerIcon"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💻" android:textSize="22sp" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvPeerName"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="No peer configured" android:textColor="@color/text_pri" android:textSize="13sp"
                        android:fontFamily="monospace" android:textStyle="bold" />
                    <TextView android:id="@+id/tvPeerPlatform"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="" android:textColor="@color/text_sec" android:textSize="11sp"
                        android:fontFamily="monospace" android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView android:id="@+id/tvPeerRole"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" android:textColor="@color/amber" android:textSize="10sp"
                    android:fontFamily="monospace" android:textStyle="bold" />
            </LinearLayout>

            <Button android:id="@+id/btnHandoff"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="HAND OFF TO PEER" android:textColor="@color/bg_deep"
                android:backgroundTint="@color/cyan" android:fontFamily="monospace"
                android:textSize="12sp" android:textStyle="bold"
                android:layout_marginBottom="32dp" />

            <!-- SAVED CONNECTIONS -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="SAVED CONNECTIONS" android:textColor="@color/cyan" android:textSize="11sp"
                android:fontFamily="monospace" android:letterSpacing="0.2"
                android:layout_marginBottom="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Switch between already-saved PCs below. To add a new PC, use the ‘+’ on the device picker screen instead — this button only saves whichever connection is currently active on this screen."
                android:textColor="@color/text_sec" android:textSize="10sp"
                android:fontFamily="monospace" android:layout_marginBottom="12dp" />

            <LinearLayout android:id="@+id/profilesContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button android:id="@+id/btnSaveCurrentAsProfile"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:text="+ SAVE CURRENTLY ACTIVE CONNECTION" android:textColor="@color/cyan"
                android:backgroundTint="@color/bg_card" android:fontFamily="monospace"
                android:textSize="11sp" android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
