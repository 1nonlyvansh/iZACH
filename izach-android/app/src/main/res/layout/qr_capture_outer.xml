<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors zxing-android-embedded's own zxing_capture.xml, adding
     app:zxing_scanner_layout to point at our custom inner layout instead
     of the library's default (which has no visible frame border and always
     shows the red laser line). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/zxing_barcode_scanner"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="false"
        app:zxing_scanner_layout="@layout/qr_scanner_view_inner"/>

</merge>
