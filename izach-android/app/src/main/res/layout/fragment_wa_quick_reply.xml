<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_panel">

    <!-- Drag handle -->
    <View
        android:id="@+id/waHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:background="#FF3a6070"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/waHeader"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/waHandle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💬 WA QUICK REPLY"
            android:textColor="#FF25D366"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseWaReply"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/waDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#4025D366"
        app:layout_constraintTop_toBottomOf="@id/waHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- To label -->
    <TextView
        android:id="@+id/tvWaTo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="To: "
        android:textColor="@color/text_pri"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/waDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Original message preview -->
    <TextView
        android:id="@+id/tvWaOriginal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_sec"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvWaTo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- AI Draft label + spinner -->
    <LinearLayout
        android:id="@+id/waDraftRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvWaOriginal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI DRAFT"
            android:textColor="@color/cyan"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />

        <ProgressBar
            android:id="@+id/progressWaDraft"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Reply EditText -->
    <EditText
        android:id="@+id/etWaReply"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_input"
        android:textColor="@color/text_pri"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:inputType="textMultiLine|textCapSentences"
        android:gravity="top|start"
        android:hint="Loading AI draft…"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/waDraftRow"
        app:layout_constraintBottom_toTopOf="@id/waSendRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Send button row -->
    <LinearLayout
        android:id="@+id/waSendRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSendWaReply"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="SEND VIA iZACH"
            android:textColor="@color/bg_deep"
            android:backgroundTint="#FF25D366"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:paddingHorizontal="20dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
