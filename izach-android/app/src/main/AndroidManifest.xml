<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="iZACH"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.iZACH">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".FileTransferActivity"
            android:exported="false" />

        <activity
            android:name=".ScreenshotViewerActivity"
            android:exported="false" />

        <activity
            android:name=".ClipboardActivity"
            android:exported="false" />

        <activity
            android:name=".SpotifyRemoteActivity"
            android:exported="false" />

        <activity
            android:name=".SystemDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".QuickShortcutsActivity"
            android:exported="false" />

        <activity
            android:name=".AlliedNodeActivity"
            android:exported="false" />

        <activity
            android:name=".TerminalActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".FloatingMicService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".widget.DndStatusWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dnd_status_widget_info" />
        </receiver>

        <receiver
            android:name=".DndActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.izach.android.DND_HANDLE" />
                <action android:name="com.izach.android.DND_BUSY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".DndInlineReplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.izach.android.DND_INLINE_REPLY" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".AudioStreamActivity"
            android:label="PC Audio"
            android:exported="false" />

        <!-- ── Quick Settings Tiles ───────────────────────────── -->
        <service
            android:name=".tile.DndTileService"
            android:exported="true"
            android:label="@string/tile_dnd"
            android:icon="@drawable/ic_bell"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.BusyTileService"
            android:exported="true"
            android:label="@string/tile_busy"
            android:icon="@drawable/ic_bell"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.LockPcTileService"
            android:exported="true"
            android:label="@string/tile_lock_pc"
            android:icon="@drawable/ic_settings"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.MutePcTileService"
            android:exported="true"
            android:label="@string/tile_mute_pc"
            android:icon="@drawable/ic_equalizer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.WidgetToggleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.izach.android.TOGGLE_DND" />
                <action android:name="com.izach.android.TOGGLE_BUSY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.PCStatusWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.izach.android.WIDGET_REFRESH_STATUS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pc_status_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickMicWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_mic_widget_info" />
        </receiver>

    </application>

</manifest>
