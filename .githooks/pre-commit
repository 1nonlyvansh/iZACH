#!/usr/bin/env bash
# Blocks: .env, api_keys.json, files > 50MB

RED='\033[0;31m'
NC='\033[0m'
BLOCKED=0

staged=$(git diff --cached --name-only | tr -d '\r')

# ── Sensitive files ───────────────────────────────────────────
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    case "$file" in
        .env.example) ;;  # template with no real secrets — allow
        .env|.env.*|api_keys.json|api_keys.*.json)
            printf "${RED}[BLOCKED]${NC} Sensitive file staged: %s\n" "$file"
            BLOCKED=1
            ;;
    esac
done <<< "$staged"

# ── Files > 50MB ──────────────────────────────────────────────
MAX=$((50 * 1024 * 1024))

while IFS= read -r file; do
    [[ -z "$file" || ! -f "$file" ]] && continue
    size=$(wc -c < "$file")
    if (( size > MAX )); then
        mb=$(( size / 1024 / 1024 ))
        printf "${RED}[BLOCKED]${NC} File too large (%sMB > 50MB): %s\n" "$mb" "$file"
        BLOCKED=1
    fi
done <<< "$staged"

if (( BLOCKED )); then
    echo ""
    echo "Commit aborted. Remove blocked files and retry."
    exit 1
fi

exit 0
