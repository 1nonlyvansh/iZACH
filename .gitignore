# ========================
# Python
# ========================
__pycache__/
*.pyc
*.pyo
*.pyd
*.db
*.sqlite3

# Virtual environments
venv/
.venv/
env/
izach_env/

# ========================
# Environment variables / secrets (CRITICAL)
# ========================
.env
.env.*
!.env.example
api_keys.json
api_keys/

# ========================
# OAuth / Google credentials (CRITICAL — never commit)
# ========================
credentials.json
token.json
token_gmail.json
service_account.json
firebase_service_account.json
google-services.json
fitness_credentials.json
fitness_token.json
smart_home_credentials.json

# Spotipy's OAuth token cache — a literal file named ".cache" at repo root
# (not a directory), holding a real access/refresh token pair.
.cache

# Phone↔PC pairing secret (HMAC key every signed API request is checked
# against) — CRITICAL, equivalent to a password.
pairing_secret.json

# ========================
# Smart Home secrets (CRITICAL)
# ========================
smart_home_settings.json

# ========================
# Instagram / Social credentials (CRITICAL)
# ========================
instagram_settings.json

# ========================
# Smart Memory / AI Memory (personal data)
# ========================
smart_memory.json
memory.json

# ========================
# Obsidian vault contents (personal notes, memory nodes)
# ========================
iZACH-Brain/Memory/
iZACH-Brain/People/
iZACH-Brain/Calls/
