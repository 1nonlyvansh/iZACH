location_companion.html

# ========================
# User personal data
# ========================
users.json
contacts.json
owner_face.pkl
*.pkl
biometric/

# Recorded browsing sessions (Cortex UI Browser widget) — may contain
# visited URLs and form input from arbitrary third-party sites
browser_recordings/

# Browser history + password vault (Cortex UI Browser widget). Vault entries
# are encrypted at rest (Electron safeStorage/DPAPI) but still never commit —
# the file is meaningless without the same OS user account anyway.
browser_history.json
browser_passwords.json
browser_permissions.json
browser_downloads.json
browser_webauthn.json
browser_tabs.json
custom_links.json

# Email agent (Gmail monitoring) — order/shipment contents and internal
# seen-message state.
tracked_orders.json
email_agent_state.json

# Voice biometrics (voice ID enrollment / speaker diarization profiles)
owner_voice.json
owner_voice.npy
voice_profiles/
speaker_profiles/

# ========================
# Command history & logs (CRITICAL)
# ========================
command_log.csv
*.log
logs/
error_logs/
*.csv

# Machine-generated watchdog wrapper scripts (contain this machine's
# absolute paths/python.exe location — regenerated by install_watchdog()/
# install_boot_daemon(), never meant to be portable or committed)
izach_watchdog.ps1
izach_boot_daemon_watchdog.ps1

